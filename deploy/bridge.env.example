RELAY_URL=ws://server-ip:8787/ws
RELAY_TOKEN=replace-with-the-same-relay-token
CODEX_PROXY_DEVICE_NAME=Linux Codex Bridge

# The bridge image does not include Codex CLI. Start codex app-server on the Linux host.
CODEX_APP_SERVER_URL=ws://127.0.0.1:53179
CODEX_AUTO_START_APP_SERVER=false
ALLOW_RAW_RPC=false
