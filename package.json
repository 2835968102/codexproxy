{
  "name": "codexproxy",
  "version": "0.1.0",
  "private": true,
  "description": "A relay server, local Codex bridge, and mobile web console for controlling Codex through a server.",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:bridge": "tsx watch src/bridge/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start:server": "node dist/src/server/index.js",
    "start:bridge": "node dist/src/bridge/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
